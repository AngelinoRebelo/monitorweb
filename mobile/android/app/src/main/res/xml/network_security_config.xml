<?xml version="1.0" encoding="utf-8"?>
<!--
  Produção: só HTTPS (Railway).
  Teste local: HTTP liberado para emulador (10.0.2.2) e localhost.
  Aparelho físico na LAN: acrescente seu IP abaixo OU use MONITORWEB_URL com HTTPS (tunnel).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- Exemplos LAN — descomente/ajuste se testar no celular físico:
        <domain includeSubdomains="true">192.168.0.10</domain>
        -->
    </domain-config>
</network-security-config>
